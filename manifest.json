{
  "manifest_version": 3,
  "name": "YT Transcript Copy",
  "version": "1.0.0",
  "description": "Copy the full transcript of a YouTube video to the clipboard in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy transcript (Shift+Alt+C)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["clipboardWrite", "declarativeContent", "offscreen", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy the transcript of the current video"
    }
  }
}
